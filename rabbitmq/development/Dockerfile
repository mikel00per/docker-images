ARG RABBITMQ_VERSION

FROM rabbitmq:${RABBITMQ_VERSION}

# Common system
RUN apk update; \
    apk upgrade; \
    apk add --no-cache \
      bash \
      shadow \
      linux-headers;

ARG UID
ARG GID
ARG UNAME
ARG GNAME

RUN addgroup -g ${GID} ${GNAME} && \
    adduser -D -u ${UID} -G ${GNAME} ${UNAME}

USER ${UNAME}

ARG RABBITMQ_HEALTHCHECK_SOURCE
ARG RABBITMQ_HEALTHCHECK_TARGET
COPY ${RABBITMQ_HEALTHCHECK_SOURCE} ${RABBITMQ_HEALTHCHECK_TARGET}

ARG RABBITMQ_CONFIG_SOURCE
ARG RABBITMQ_CONFIG_TARGET
COPY ${RABBITMQ_CONFIG_SOURCE} ${RABBITMQ_CONFIG_TARGET}

HEALTHCHECK --interval=10s --timeout=3s --retries=3 CMD ["docker-healthcheck"]

ARG RABBITMQ_PORT
ARG RABBITMQ_PORT_PANEL
EXPOSE ${RABBITMQ_PORT}
EXPOSE ${RABBITMQ_PORT_PANEL}
