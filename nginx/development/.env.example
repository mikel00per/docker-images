# Global config to all images
VERSION_TAG=0.0.1

# Nginx
NGINX_NAME=nginx-alpine-development
NGINX_CONTEXT=./development
NGINX_VERSION=alpine

NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

NGINX_CONFIG_SOURCE=./nginx.conf
NGINX_CONFIG_TARGET=/etc/nginx/conf.d/default.conf

NGINX_PAGES_SOURCE=./pages
NGINX_PAGES_TARGET=/etc/nginx/pages

SSL_CERTIFICATE_SOURCE=./certs/server.crt
SSL_CERTIFICATE_TARGET=/etc/nginx/certs/server.crt
SSL_CERTIFICATE_KEY_SOURCE=./certs/server.key
SSL_CERTIFICATE_KEY_TARGET=/etc/nginx/certs/server.key

NGINX_HEALTHCHECK_SOURCE=./healthcheck.sh
NGINX_HEALTHCHECK_TARGET=/usr/local/bin/docker-healthcheck